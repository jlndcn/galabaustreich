{
  "name": "garten-streich",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:performance": "node tests/performance.mjs",
    "test:security": "node tests/security-check.mjs",
    "format": "prettier --write src tests astro.config.mjs playwright.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests astro.config.mjs playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "astro": "7.3.2",
    "nodemailer": "10.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3"
  }
}
