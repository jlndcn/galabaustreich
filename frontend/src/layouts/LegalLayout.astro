---
interface Props {
  title: string;
  lead?: string;
  stand?: string;
}
const { title, lead, stand } = Astro.props;
---

<article class="container legal-page" data-testid="legal-page">
  <header class="legal-heading">
    <p class="eyebrow">Garten- und Landschaftspflege Streich</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {stand && (
      <p class="small" data-testid="legal-stand">
        Stand: {stand}
      </p>
    )}
  </header>
  <div class="legal-copy">
    <slot />
  </div>
</article>
