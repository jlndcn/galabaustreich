---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site } from '../data/site';
interface Props {
  seo: { title: string; description: string; path: string };
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { seo, jsonLd, noindex = false } = Astro.props;
const indexable = process.env.CONTEXT === 'production' && !noindex;
const canonical = new URL(seo.path, site.domain).href;
const image = `${site.domain}/og-image.jpg`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f2e14" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.displayName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={site.displayName} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/logo192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="preload"
      href="/fonts/figtree-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main" tabindex="0">
      Zum Inhalt springen
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>
